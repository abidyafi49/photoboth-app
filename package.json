{
  "name": "photobooth",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/web",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
